# ---------- 基础 ----------
APP_NAME=zaima-api
# dev / test / prod
APP_ENV=dev
DEBUG=true
API_PREFIX=/api
DOCS_ENABLED=true

# ---------- 数据库 ----------
# 生产示例：postgresql+psycopg://user:password@db:5432/zaima
DATABASE_URL=postgresql+psycopg://zaima:zaima@127.0.0.1:55432/zaima
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=1800
DB_POOL_TIMEOUT=30
DB_ECHO=false
# 开发/测试可自动建表；生产必须为 false 并使用 Alembic
AUTO_CREATE_TABLES=true

# ---------- CORS ----------
# 多个来源用英文逗号分隔；生产请写具体域名
CORS_ORIGINS=*

# ---------- 静态资源（一体化调试镜像）----------
# 指向 H5 构建产物目录；只有 APP_ENV=dev 时才生效，非 dev 环境会被忽略。
# 托管范围仅 / 与 /assets/*，其余路径一律 404。
STATIC_DIR=
# 可选访问口令：设置后必须用 /?k=<口令> 才能打开页面（仅 dev 生效，默认关闭）
STATIC_ACCESS_KEY=

# ---------- 日志 ----------
LOG_LEVEL=INFO
LOG_JSON=false

# ---------- 业务默认值 ----------
DEFAULT_PERIOD_DAYS=1
DEFAULT_CHECKIN_TIME=08:00
DEFAULT_TIMEZONE=Asia/Shanghai
MAX_GUARDIANS=3
ALLOWED_PERIOD_DAYS=1,2,3,7
# 相对「应确认时间」的提醒偏移（分钟）：30=08:30, 240=12:00, 720=20:00
REMINDER_OFFSETS_MINUTES=30,240,720
# 次日同一时刻触发异常事件（分钟）
ALERT_OFFSET_MINUTES=1440

# ---------- 邮件 ----------
# dev/test 使用 mock（写本地 .mailbox 目录，simulated=true）
# prod 必须使用 smtp
EMAIL_ADAPTER=mock
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.com
SMTP_FROM_NAME=在吗
SMTP_USE_TLS=true
SMTP_TIMEOUT_SECONDS=15
EMAIL_MAX_ATTEMPTS=3
EMAIL_RETRY_BACKOFF_SECONDS=60
EMAIL_MOCK_DIR=./.mailbox

# ---------- 调度 ----------
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=60
SCHEDULER_BATCH_SIZE=200
SCHEDULER_LOCK_KEY=918273645
# 允许通过 X-Debug-Now 请求头模拟时间推进（仅 dev/test）
ALLOW_TIME_TRAVEL=true
