# =============================================================================
# Dockerfile.nginx —— 可运行测试镜像（nginx:alpine + 预构建 H5）
#
# 不在镜像内跑 npm build，只复制 h5-dist/，因此构建很快、体积小。
# 启动后访问 http://localhost:8080/ 即可看到页面，适合快速验证/演示。
#
# 用法：
#   docker build -f Dockerfile.nginx -t zaima-h5 .
#   docker run --rm -p 8080:80 zaima-h5
# =============================================================================
FROM nginx:alpine

# 预构建的 H5 产物（由 CI/本地提供）
COPY h5-dist/ /usr/share/nginx/html/

# SPA/相对路径兜底：未命中具体文件时回退 index.html，
# 避免刷新子路由出现 404（本项目为 hash 模式，理论上不会命中该分支，属兜底）。
RUN printf 'server {\n  listen 80;\n  root /usr/share/nginx/html;\n  index index.html;\n  location / { try_files $uri $uri/ /index.html; }\n}\n' > /etc/nginx/conf.d/default.conf

EXPOSE 80

# 容器级健康检查：首页可访问即视为健康
HEALTHCHECK --interval=10s --timeout=3s --retries=3 \
    CMD wget -qO- http://127.0.0.1/ >/dev/null 2>&1 || exit 1
