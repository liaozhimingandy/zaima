# =============================================================================
# ci-cd.yml  -- 通用公共 CI/CD 模板（任意工程 drop-in 即用）
#
# 设计目标：一次构建、多处复用，不重复跑相同步骤（省时）。
# 作业 DAG：
#
#   setup ─┬─ ci            测试/检查（PR 与 push 都跑，作为质量门禁）
#          ├─ build-static  前端只编译一次 HTML → 上传 artifact(dist)
#          │      ├─ docker-assets  下载 dist → 打成 scratch 静态镜像(不重编)
#          │      └─ cloudflare     下载 dist → 部署 Pages(不重编)
#          ├─ docker-app   应用镜像（与前端构建互相独立，并行）
#          └─ release      v* tag 自动发版
#
# 自动识别：有 pyproject/requirements → 后端；有 package.json → 前端；都有 → 全栈。
# 预留自定义步骤：仓库根 .ci/hooks/ 下放同名脚本即被调用（见 .ci/hooks/README.md）。
#
# 项目变量(GitHub Variables，均有默认值，通常无需配置)：
#   PROJECT_TYPE / ENABLE_DOCKER_APP / ENABLE_DOCKER_ASSETS / ENABLE_STATIC_CLOUDFLARE
#   REGISTRY / DOCKER_IMAGE / DOCKERFILE_PATH / STATIC_BUILD_CMD / STATIC_DIST_DIR
#   ASSETS_DOCKERFILE / CLOUDFLARE_PROJECT / PYTHON_VERSION / NODE_VERSION
# Secrets：DOCKER_USERNAME / DOCKER_PASSWORD / CLOUDFLARE_API_TOKEN / CLOUDFLARE_ACCOUNT_ID
# =============================================================================
name: CI/CD

on:
  push:
    branches: [main]
    tags: ['v*']
  pull_request:
    branches: [main]
  workflow_dispatch:

# 同一分支/PR 的旧运行自动取消，避免排队浪费时间（tag 发版不取消）
concurrency:
  group: ${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: ${{ github.event_name == 'pull_request' }}

permissions:
  contents: read

env:
  REGISTRY: ${{ vars.REGISTRY || 'registry.cn-hangzhou.aliyuncs.com' }}
  DOCKER_IMAGE: ${{ vars.DOCKER_IMAGE }}
  DOCKERFILE_PATH: ${{ vars.DOCKERFILE_PATH || 'Dockerfile' }}
  STATIC_BUILD_CMD: ${{ vars.STATIC_BUILD_CMD || 'npm run build' }}
  STATIC_DIST_DIR: ${{ vars.STATIC_DIST_DIR || 'dist' }}
  ASSETS_DOCKERFILE: ${{ vars.ASSETS_DOCKERFILE || '.ci/docker-assets/Dockerfile.assets' }}
  CLOUDFLARE_PROJECT: ${{ vars.CLOUDFLARE_PROJECT }}
  NODE_VERSION: ${{ vars.NODE_VERSION || '22' }}
  PYTHON_VERSION: ${{ vars.PYTHON_VERSION || '3.14' }}

jobs:
  # ===========================================================================
  # 1) 探测：判断后端/前端/全栈，以及各构建是否启用（输出供后续作业 if 使用）
  # ===========================================================================
  setup:
    runs-on: ubuntu-latest
    outputs:
      is_backend: ${{ steps.detect.outputs.is_backend }}
      is_frontend: ${{ steps.detect.outputs.is_frontend }}
      type: ${{ steps.detect.outputs.type }}
      docker_app: ${{ steps.detect.outputs.docker_app }}
      docker_assets: ${{ steps.detect.outputs.docker_assets }}
      frontend_dir: ${{ steps.fe.outputs.frontend_dir }}
      frontend_lock: ${{ steps.fe.outputs.frontend_lock }}
      frontend_pm: ${{ steps.fe.outputs.frontend_pm }}
    steps:
      - uses: actions/checkout@v4

      # 自动定位前端目录（可能在 frontend/ web/ 等子目录），并找到锁文件
      # 解决：前端不在根时 setup-node 的 cache:npm 找不到 package-lock 而报错
      - name: Detect frontend dir
        id: fe
        run: |
          if [ -f .ci/scripts/detect-frontend.sh ]; then
            bash .ci/scripts/detect-frontend.sh >> "$GITHUB_OUTPUT"
          else   # 容错：未安装 .ci/ 时退回根目录判断
            echo "frontend_dir=." >> "$GITHUB_OUTPUT"
            echo "frontend_lock=" >> "$GITHUB_OUTPUT"
            echo "has_frontend=$([ -f package.json ] && echo true || echo false)" >> "$GITHUB_OUTPUT"
          fi

      # 汇总项目类型与各构建开关（显式变量优先，否则自动探测）
      # 注意：全部用显式 if，避免 set -e 下 [ -f x ] && ... 在文件不存在时让步骤失败
      - id: detect
        run: |
          is_backend=false
          if [ -f pyproject.toml ] || [ -f requirements.txt ] || [ -f setup.py ]; then is_backend=true; fi
          is_frontend="${{ steps.fe.outputs.has_frontend }}"
          if $is_backend && [ "$is_frontend" = "true" ]; then type=fullstack
          elif $is_backend; then type=backend
          elif [ "$is_frontend" = "true" ]; then type=frontend
          else type=unknown; fi

          # 应用镜像：显式 true/false 优先，否则按 Dockerfile 是否存在自动判断
          da="${{ vars.ENABLE_DOCKER_APP }}"
          if [ "$da" = "true" ]; then docker_app=true
          elif [ "$da" = "false" ]; then docker_app=false
          elif [ -f "${{ env.DOCKERFILE_PATH }}" ]; then docker_app=true
          else docker_app=false; fi

          # 静态资源镜像：显式优先，否则前端默认启用
          dast="${{ vars.ENABLE_DOCKER_ASSETS }}"
          if [ "$dast" = "true" ]; then docker_assets=true
          elif [ "$dast" = "false" ]; then docker_assets=false
          elif [ "$is_frontend" = "true" ]; then docker_assets=true
          else docker_assets=false; fi

          { echo "is_backend=$is_backend"; echo "is_frontend=$is_frontend"; echo "type=$type";
            echo "docker_app=$docker_app"; echo "docker_assets=$docker_assets"; } >> "$GITHUB_OUTPUT"
          echo "project: type=$type backend=$is_backend frontend=$is_frontend dir=${{ steps.fe.outputs.frontend_dir }} lock=${{ steps.fe.outputs.frontend_lock }}"

  # ===========================================================================
  # 2) CI：后端/前端分别 lint+test（无对应语言自动跳过；PR 与 push 都跑）
  # ===========================================================================
  ci:
    needs: setup
    # tag 发版时跳过（main 上已通过质量门禁），仅构建与发版，省时
    if: ${{ needs.setup.outputs.type != 'unknown' && !startsWith(github.ref, 'refs/tags/') }}
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      # 仅后端项目执行（含 uv 环境）
      - name: Backend — setup / lint / test
        if: ${{ needs.setup.outputs.is_backend == 'true' }}
        run: |
          command -v uv >/dev/null 2>&1 || curl -LsSf https://astral.sh/uv/install.sh | sh
          export PATH="$HOME/.local/bin:$PATH"
          if [ -f uv.lock ]; then uv sync --no-dev; fi
          if [ -f requirements.txt ]; then pip install -r requirements.txt; fi
          uv run ruff check . 2>/dev/null || true          # 风格检查失败不阻断
          if [ -f uv.lock ]; then uv run pytest -q; else pytest -q 2>/dev/null || true; fi

      # 仅前端项目执行；支持前端在子目录；无锁文件时不启用 npm 缓存（否则 setup-node 报错）
      - name: Frontend — setup node
        if: ${{ needs.setup.outputs.is_frontend == 'true' }}
        uses: actions/setup-node@v4
        with:
          node-version: ${{ env.NODE_VERSION }}
          # 有锁文件才开缓存；留空即不缓存，避免 “Dependencies lock file is not found”
          cache: ${{ needs.setup.outputs.frontend_lock != '' && needs.setup.outputs.frontend_pm || '' }}
          cache-dependency-path: ${{ needs.setup.outputs.frontend_lock }}
      - name: Frontend — lint / test
        if: ${{ needs.setup.outputs.is_frontend == 'true' }}
        working-directory: ${{ needs.setup.outputs.frontend_dir }}
        run: |
          # 按实际包管理器安装（无锁文件则 npm install）
          if [ -z "${{ needs.setup.outputs.frontend_lock }}" ]; then npm install
          elif [ "${{ needs.setup.outputs.frontend_pm }}" = "pnpm" ]; then corepack enable; pnpm install --frozen-lockfile
          elif [ "${{ needs.setup.outputs.frontend_pm }}" = "yarn" ]; then yarn install --frozen-lockfile
          else npm ci; fi
          npm run lint --if-present
          npm test --if-present

      # 用户自定义检查（存在才执行）
      - name: Custom hook — ci.sh
        if: ${{ hashFiles('.ci/hooks/ci.sh') != '' }}
        run: bash .ci/hooks/ci.sh
        env:
          PROJECT_TYPE: ${{ needs.setup.outputs.type }}
          IS_BACKEND: ${{ needs.setup.outputs.is_backend }}
          IS_FRONTEND: ${{ needs.setup.outputs.is_frontend }}

  # ===========================================================================
  # 3) 前端编译：HTML 只编译一次，上传 artifact 供下游复用（避免重复 npm build）
  #    仅在需要「静态镜像」或「Cloudflare 部署」且为前端时运行
  # ===========================================================================
  build-static:
    needs: setup
    if: >-
      ${{ github.event_name != 'pull_request' &&
          needs.setup.outputs.is_frontend == 'true' &&
          (needs.setup.outputs.docker_assets == 'true' || vars.ENABLE_STATIC_CLOUDFLARE == 'true') }}
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: Custom hook — pre-build.sh
        if: ${{ hashFiles('.ci/hooks/pre-build.sh') != '' }}
        run: bash .ci/hooks/pre-build.sh

      - uses: actions/setup-node@v4
        with:
          node-version: ${{ env.NODE_VERSION }}
          cache: ${{ needs.setup.outputs.frontend_lock != '' && needs.setup.outputs.frontend_pm || '' }}
          cache-dependency-path: ${{ needs.setup.outputs.frontend_lock }}

      # 在前端目录内编译 HTML（支持前端位于子目录）；无锁文件则 npm install
      - name: Build HTML once
        working-directory: ${{ needs.setup.outputs.frontend_dir }}
        run: |
          # 按实际包管理器安装（无锁文件则 npm install）
          if [ -z "${{ needs.setup.outputs.frontend_lock }}" ]; then npm install
          elif [ "${{ needs.setup.outputs.frontend_pm }}" = "pnpm" ]; then corepack enable; pnpm install --frozen-lockfile
          elif [ "${{ needs.setup.outputs.frontend_pm }}" = "yarn" ]; then yarn install --frozen-lockfile
          else npm ci; fi
          ${{ env.STATIC_BUILD_CMD }}
          # SPA 回退：前端路由 404 兜底
          cp "${{ env.STATIC_DIST_DIR }}/index.html" "${{ env.STATIC_DIST_DIR }}/404.html" 2>/dev/null || true

      # 把产物统一到仓库根 dist/（Dockerfile.assets 固定 COPY dist/，Cloudflare 也部署 dist）
      - name: Normalize dist to repo root
        run: |
          SRC="${{ needs.setup.outputs.frontend_dir }}/${{ env.STATIC_DIST_DIR }}"
          if [ "$SRC" != "dist" ] && [ "$SRC" != "./dist" ]; then rm -rf dist; cp -r "$SRC" dist; fi

      # 关键：产物上传，下游 docker-assets / cloudflare 直接下载，不再构建
      - name: Upload dist artifact
        uses: actions/upload-artifact@v4
        with:
          name: static-dist
          path: dist
          retention-days: 1

  # ===========================================================================
  # 4) 应用镜像：构建 + 推送（版本号 + sha + latest）；与前端构建并行
  # ===========================================================================
  docker-app:
    needs: setup
    if: >-
      ${{ github.event_name != 'pull_request' &&
          needs.setup.outputs.docker_app == 'true' }}
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0   # 需要完整历史以读取 tag / sha

      - name: Custom hook — pre-build.sh
        if: ${{ hashFiles('.ci/hooks/pre-build.sh') != '' }}
        run: bash .ci/hooks/pre-build.sh

      # 多架构支持（amd64 + arm64）
      - uses: docker/setup-qemu-action@v3
      - uses: docker/setup-buildx-action@v3
      - uses: docker/login-action@v3
        with:
          registry: ${{ env.REGISTRY != '' && env.REGISTRY || 'docker.io' }}
          username: ${{ secrets.DOCKER_USERNAME }}
          password: ${{ secrets.DOCKER_PASSWORD }}

      # 计算版本号与构建号：语义版本(优先 git tag，其次 VERSION 文件) + 自增长构建号(run_number)
      # 输出 build-info.json，便于在镜像内/制品中定位“这是哪一次打包”
      - name: Generate build metadata
        id: build
        run: |
          if [[ "${GITHUB_REF}" == refs/tags/v* ]]; then
            VERSION="${GITHUB_REF_NAME#v}"                 # 从 v1.2.3 去掉 v
          elif [ -f VERSION ]; then
            VERSION="$(tr -d '[:space:]' < VERSION)"       # 回退：读 VERSION 文件
          else
            VERSION="0.0.0"
          fi
          BUILD_NUMBER="${GITHUB_RUN_NUMBER}"              # 每次运行自增，永不重复
          BUILD_DATE="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
          GIT_SHA_SHORT="${GITHUB_SHA::7}"
          FULL_VERSION="${VERSION}-b${BUILD_NUMBER}"
          {
            echo "version=$VERSION"; echo "build_number=$BUILD_NUMBER"
            echo "build_date=$BUILD_DATE"; echo "git_sha=$GIT_SHA_SHORT"
            echo "full_version=$FULL_VERSION"
          } >> "$GITHUB_OUTPUT"
          cat > build-info.json <<JSON
          {"version":"$VERSION","build_number":$BUILD_NUMBER,"full_version":"$FULL_VERSION","git_sha":"$GIT_SHA_SHORT","git_ref":"${GITHUB_REF}","build_date":"$BUILD_DATE","repository":"${GITHUB_REPOSITORY}","run_id":"${GITHUB_RUN_ID}"}
          JSON
          echo "build metadata: $FULL_VERSION ($BUILD_DATE, sha=$GIT_SHA_SHORT)"

      # 标签：sha / 完整构建版本(1.2.3-b45) / 语义版本(仅 tag) / latest(仅 main)
      - id: meta
        uses: docker/metadata-action@v5
        with:
          images: ${{ env.REGISTRY != '' && format('{0}/{1}', env.REGISTRY, env.DOCKER_IMAGE) || env.DOCKER_IMAGE }}
          tags: |
            type=sha,prefix=sha-,format=short
            type=raw,value=${{ steps.build.outputs.full_version }}
            type=semver,pattern={{version}},enable=${{ startsWith(github.ref, 'refs/tags/v') }}
            type=raw,value=latest,enable=${{ github.ref == 'refs/heads/main' }}
          labels: |
            org.opencontainers.image.version=${{ steps.build.outputs.version }}
            org.opencontainers.image.revision=${{ github.sha }}
            org.opencontainers.image.created=${{ steps.build.outputs.build_date }}
            org.opencontainers.image.source=${{ github.server_url }}/${{ github.repository }}
            build.number=${{ steps.build.outputs.build_number }}
            build.date=${{ steps.build.outputs.build_date }}
            build.full_version=${{ steps.build.outputs.full_version }}

      - uses: docker/build-push-action@v6
        with:
          context: .
          file: ${{ env.DOCKERFILE_PATH }}
          platforms: linux/amd64,linux/arm64
          push: true
          tags: ${{ steps.meta.outputs.tags }}
          labels: ${{ steps.meta.outputs.labels }}
          # 传给 Dockerfile，供其 LABEL / 写入 build-info.json 使用
          build-args: |
            BUILD_VERSION=${{ steps.build.outputs.full_version }}
            BUILD_NUMBER=${{ steps.build.outputs.build_number }}
            BUILD_DATE=${{ steps.build.outputs.build_date }}
            GIT_SHA=${{ steps.build.outputs.git_sha }}
          cache-from: type=gha
          cache-to: type=gha,mode=max

      - name: Custom hook — post-build.sh
        if: ${{ hashFiles('.ci/hooks/post-build.sh') != '' }}
        run: bash .ci/hooks/post-build.sh
        env:
          IMAGE_TAGS: ${{ steps.meta.outputs.tags }}

  # ===========================================================================
  # 5) 静态资源镜像：下载 build-static 的 dist → 打成 scratch 镜像（不重编前端）
  # ===========================================================================
  docker-assets:
    needs: [setup, build-static]
    if: >-
      ${{ github.event_name != 'pull_request' &&
          needs.setup.outputs.docker_assets == 'true' }}
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0

      # 复用上一步产物，跳过 npm ci / npm build
      - name: Download dist artifact
        uses: actions/download-artifact@v4
        with:
          name: static-dist
          path: dist   # 与 build-static 归一化后的根目录一致

      - name: Custom hook — pre-build.sh
        if: ${{ hashFiles('.ci/hooks/pre-build.sh') != '' }}
        run: bash .ci/hooks/pre-build.sh

      - uses: docker/setup-qemu-action@v3
      - uses: docker/setup-buildx-action@v3
      - uses: docker/login-action@v3
        with:
          registry: ${{ env.REGISTRY != '' && env.REGISTRY || 'docker.io' }}
          username: ${{ secrets.DOCKER_USERNAME }}
          password: ${{ secrets.DOCKER_PASSWORD }}

      # 计算版本号与构建号（与 docker-app 同规则），保证静态镜像也能定位版本
      - name: Generate build metadata
        id: build
        run: |
          if [[ "${GITHUB_REF}" == refs/tags/v* ]]; then
            VERSION="${GITHUB_REF_NAME#v}"
          elif [ -f VERSION ]; then
            VERSION="$(tr -d '[:space:]' < VERSION)"
          else
            VERSION="0.0.0"
          fi
          BUILD_NUMBER="${GITHUB_RUN_NUMBER}"
          BUILD_DATE="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
          GIT_SHA_SHORT="${GITHUB_SHA::7}"
          FULL_VERSION="${VERSION}-b${BUILD_NUMBER}"
          {
            echo "version=$VERSION"; echo "build_number=$BUILD_NUMBER"
            echo "build_date=$BUILD_DATE"; echo "git_sha=$GIT_SHA_SHORT"
            echo "full_version=$FULL_VERSION"
          } >> "$GITHUB_OUTPUT"
          echo "build metadata: $FULL_VERSION"

      # -assets 后缀：与应用镜像区分，便于独立分发
      - id: meta
        uses: docker/metadata-action@v5
        with:
          images: ${{ env.REGISTRY != '' && format('{0}/{1}', env.REGISTRY, env.DOCKER_IMAGE) || env.DOCKER_IMAGE }}
          flavor:
            suffix=-assets,onlatest=true
          tags: |
            type=sha,prefix=sha-,format=short
            type=raw,value=${{ steps.build.outputs.full_version }}
            type=semver,pattern={{version}},enable=${{ startsWith(github.ref, 'refs/tags/v') }}
            type=raw,value=latest,enable=${{ github.ref == 'refs/heads/main' }}
          labels: |
            org.opencontainers.image.version=${{ steps.build.outputs.version }}
            org.opencontainers.image.revision=${{ github.sha }}
            org.opencontainers.image.created=${{ steps.build.outputs.build_date }}
            build.number=${{ steps.build.outputs.build_number }}
            build.date=${{ steps.build.outputs.build_date }}
            build.full_version=${{ steps.build.outputs.full_version }}

      - uses: docker/build-push-action@v6
        with:
          context: .
          file: ${{ env.ASSETS_DOCKERFILE }}
          platforms: linux/amd64,linux/arm64
          push: true
          tags: ${{ steps.meta.outputs.tags }}
          labels: ${{ steps.meta.outputs.labels }}
          build-args: |
            BUILD_VERSION=${{ steps.build.outputs.full_version }}
            BUILD_NUMBER=${{ steps.build.outputs.build_number }}
            BUILD_DATE=${{ steps.build.outputs.build_date }}
            GIT_SHA=${{ steps.build.outputs.git_sha }}
          cache-from: type=gha
          cache-to: type=gha,mode=max

      - name: Custom hook — post-build.sh
        if: ${{ hashFiles('.ci/hooks/post-build.sh') != '' }}
        run: bash .ci/hooks/post-build.sh
        env:
          IMAGE_TAGS: ${{ steps.meta.outputs.tags }}

  # ===========================================================================
  # 6) Cloudflare Pages：下载 dist artifact 直接部署（不重编前端）
  # ===========================================================================
  cloudflare:
    needs: [setup, build-static]
    if: >-
      ${{ github.event_name != 'pull_request' &&
          vars.ENABLE_STATIC_CLOUDFLARE == 'true' &&
          needs.setup.outputs.is_frontend == 'true' }}
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: Download dist artifact
        uses: actions/download-artifact@v4
        with:
          name: static-dist
          path: dist   # 与 build-static 归一化后的根目录一致

      - name: Custom hook — pre-deploy.sh
        if: ${{ hashFiles('.ci/hooks/pre-deploy.sh') != '' }}
        run: bash .ci/hooks/pre-deploy.sh
        env:
          CLOUDFLARE_PROJECT: ${{ env.CLOUDFLARE_PROJECT }}
          STATIC_DIST_DIR: ${{ env.STATIC_DIST_DIR }}

      - name: Deploy to Cloudflare Pages
        id: deploy
        uses: cloudflare/wrangler-action@v4
        with:
          apiToken: ${{ secrets.CLOUDFLARE_API_TOKEN }}
          accountId: ${{ secrets.CLOUDFLARE_ACCOUNT_ID }}
          command: pages deploy dist --project-name=${{ env.CLOUDFLARE_PROJECT }} --branch main

      - name: Custom hook — post-deploy.sh
        if: ${{ hashFiles('.ci/hooks/post-deploy.sh') != '' }}
        run: bash .ci/hooks/post-deploy.sh
        env:
          CLOUDFLARE_PROJECT: ${{ env.CLOUDFLARE_PROJECT }}
          DEPLOY_URL: ${{ steps.deploy.outputs.deployment-url }}

  # ===========================================================================
  # 7) 发布：推送 v* tag 自动生成 GitHub Release
  # ===========================================================================
  release:
    if: ${{ startsWith(github.ref, 'refs/tags/v') }}
    runs-on: ubuntu-latest
    permissions:
      contents: write
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0
      # 用相邻两个 tag 之间的提交生成变更摘要
      - name: Generate changelog
        id: changelog
        run: |
          PREV=$(git describe --tags --abbrev=0 HEAD^ 2>/dev/null || echo "")
          if [ -n "$PREV" ]; then LOG=$(git log ${PREV}..HEAD --pretty=format:'- %s (%an)')
          else LOG=$(git log --pretty=format:'- %s (%an)'); fi
          { echo "log<<EOF"; echo "$LOG"; echo "EOF"; } >> "$GITHUB_OUTPUT"
      - uses: softprops/action-gh-release@v2
        with:
          generate_release_notes: true
          body: |
            ## 变更摘要
            ${{ steps.changelog.outputs.log }}
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
