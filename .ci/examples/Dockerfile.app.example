# =============================================================================
# Dockerfile.app.example -- 在应用镜像中固化「构建信息」（可选但推荐）
# 复制到项目根 Dockerfile 时，保留下面 ARG / LABEL / COPY build-info.json 部分即可。
# CI 的 “Generate build metadata” 步骤会在工作区根生成 build-info.json。
# 本地构建若没有该文件，请先手动生成，或删掉 COPY 行。
# =============================================================================
FROM python:3.14-slim

# 由 docker/build-push-action 的 build-args 注入（见 ci-cd.yml）
ARG BUILD_VERSION=dev
ARG BUILD_NUMBER=0
ARG BUILD_DATE
ARG GIT_SHA

LABEL org.opencontainers.image.version="$BUILD_VERSION" \
      org.opencontainers.image.revision="$GIT_SHA" \
      org.opencontainers.image.created="$BUILD_DATE" \
      build.number="$BUILD_NUMBER"

WORKDIR /app
COPY . /app

# 构建信息文件：docker run 后可 cat /app/build-info.json 定位版本
COPY build-info.json /app/build-info.json

CMD ["python", "-m", "app"]
