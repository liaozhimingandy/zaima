# =============================================================================
# .ci/project.config.yaml -- 项目专属配置（单一来源）
# CI 直接读取本文件（.ci/scripts/read-config.sh）；GitHub Variables 仅作缺省回退。
# 改完无需再同步 Variables；如需回退到 Variables，删掉对应项即可。
# =============================================================================
project:
  name: rhapsody                 # 项目名（仓库名）
  version: 7.4.0                 # 语义化版本（CI/镜像 tag 来源）
  license: MIT
  type: auto                     # auto | backend | frontend | fullstack（auto=按文件探测）

# ---- 开关：控制各构建阶段是否启用（auto=按项目文件自动探测） ----
enable:
  docker_app: auto               # 应用镜像：auto(有 Dockerfile 即启用) | true | false
  docker_assets: auto            # 静态资源独立镜像：auto(前端即启用) | true | false
  static_cloudflare: false      # Cloudflare Pages 部署：需显式 true 并配 Secret

docker:
  registry: registry.cn-hangzhou.aliyuncs.com   # 阿里云 ACR；Docker Hub 填 docker.io（勿留空）
  image: liaozhiming/rhapsody     # <namespace>/<project>
  dockerfile: Dockerfile          # 相对仓库根；如 backend/Dockerfile
  context: .                      # 构建上下文；后端在子目录时填 backend/
  platforms: linux/amd64,linux/arm64

static:
  build_command: npm run build
  output_dir: dist
  assets_image:                  # 静态资源独立镜像（scratch，可独立分发）
    dockerfile: .ci/docker-assets/Dockerfile.assets
    # 构建产物镜像标签: <image>:<version>-assets / :latest-assets / :sha-xxxx-assets

cloudflare:
  project: ""                    # Cloudflare Pages 项目名（enable.static_cloudflare=true 时必填）

# ---- 可选：自定义步骤钩子（在 .ci/hooks/ 下放同名脚本即生效，详见 .ci/hooks/README.md） ----
# hooks:
#   ci: .ci/hooks/ci.sh
#   pre_build: .ci/hooks/pre-build.sh
#   post_build: .ci/hooks/post-build.sh
#   pre_deploy: .ci/hooks/pre-deploy.sh
#   post_deploy: .ci/hooks/post-deploy.sh
