# =============================================================================
# ci.yml  -- 公共 CI 模板（任意工程 drop-in）
# 触发: push 到 main/develop / 任意 PR
# 作用: 自动识别后端(Python)或前端(Node)，执行对应 lint/test；无对应语言则跳过
# 用户自定义步骤: 在仓库 .ci/hooks/ci.sh 放入项目专属检查（lint/test 之后运行，详见 .ci/hooks/README.md）
#
# 项目专属变量(GitHub Variables):
#   PYTHON_VERSION  默认 3.14
#   NODE_VERSION   默认 22
# =============================================================================
name: CI

on:
  push:
    branches: [main, develop]
  pull_request:
    branches: [main]

permissions:
  contents: read

env:
  PYTHON_VERSION: ${{ vars.PYTHON_VERSION || '3.14' }}
  NODE_VERSION: ${{ vars.NODE_VERSION || '22' }}

jobs:
  lint-test:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Backend (Python) setup + lint + test
        if: ${{ hashFiles('pyproject.toml', 'requirements.txt', 'setup.py') != '' }}
        run: |
          command -v uv >/dev/null 2>&1 || curl -LsSf https://astral.sh/uv/install.sh | sh
          export PATH="$HOME/.local/bin:$PATH"
          if [ -f uv.lock ]; then uv sync --no-dev || uv sync; fi
          if [ -f requirements.txt ]; then pip install -r requirements.txt; fi
          uv run ruff check . 2>/dev/null || true
          if [ -f uv.lock ]; then uv run pytest -q; else pytest -q 2>/dev/null || true; fi

      # 自动定位前端目录（可能在子目录），并找到锁文件
      - name: Detect frontend dir
        id: fe
        run: bash .ci/scripts/detect-frontend.sh >> "$GITHUB_OUTPUT"

      - name: Frontend (Node) setup + lint + test
        if: ${{ steps.fe.outputs.has_frontend == 'true' }}
        uses: actions/setup-node@v4
        with:
          node-version: ${{ env.NODE_VERSION }}
          # 有锁文件才开缓存；留空避免 “Dependencies lock file is not found”
          cache: ${{ steps.fe.outputs.frontend_lock != '' && steps.fe.outputs.frontend_pm || '' }}
          cache-dependency-path: ${{ steps.fe.outputs.frontend_lock }}
      - name: Frontend install + lint + test
        if: ${{ steps.fe.outputs.has_frontend == 'true' }}
        working-directory: ${{ steps.fe.outputs.frontend_dir }}
        run: |
          if [ -z "${{ steps.fe.outputs.frontend_lock }}" ]; then npm install
          elif [ "${{ steps.fe.outputs.frontend_pm }}" = "pnpm" ]; then corepack enable; pnpm install --frozen-lockfile
          elif [ "${{ steps.fe.outputs.frontend_pm }}" = "yarn" ]; then yarn install --frozen-lockfile
          else npm ci; fi
          npm run lint --if-present
          npm test --if-present

      - name: Custom CI hook (.ci/hooks/ci.sh)
        if: ${{ hashFiles('.ci/hooks/ci.sh') != '' }}
        run: bash .ci/hooks/ci.sh
