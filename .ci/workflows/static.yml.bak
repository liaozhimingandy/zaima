# =============================================================================
# static.yml  -- 公共静态资源部署模板（Cloudflare Pages，基于 vue 真实模式）
# 仅前端/静态站点项目启用；无静态资源项目请勿启用本文件。
# 触发: 推送 v* tag / main
# 真实参考: vue_tuiwen/.github/workflows/build.yml（cloudflare/wrangler-action@v4）
#
# 项目专属变量(Variables):
#   STATIC_BUILD_CMD  如 npm run build
#   STATIC_DIST_DIR   如 dist
#   CLOUDFLARE_PROJECT  Pages 项目名（vue 真实为 tuiwen）
# Secrets:
#   CLOUDFLARE_API_TOKEN  (需 Account > Cloudflare Pages > Edit)
#   CLOUDFLARE_ACCOUNT_ID
# 用户自定义步骤: 在仓库 .ci/hooks/ 下放 pre-deploy.sh / post-deploy.sh 即被调用（详见 .ci/hooks/README.md）。
# =============================================================================
name: Deploy Static (Cloudflare Pages)

on:
  push:
    tags: ['v*']
    branches: [main]
  workflow_dispatch:
  # 说明：不设 paths 过滤，避免前端位于子目录时漏触发；tag 发版也必触发。

permissions:
  contents: read

env:
  BUILD_CMD: ${{ vars.STATIC_BUILD_CMD || 'npm run build' }}
  DIST_DIR: ${{ vars.STATIC_DIST_DIR || 'dist' }}
  PROJECT: ${{ vars.CLOUDFLARE_PROJECT }}

jobs:
  deploy:
    # 仅当显式开启 Cloudflare 部署时执行
    if: ${{ vars.ENABLE_STATIC_CLOUDFLARE == 'true' }}
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: Custom pre-deploy hook (.ci/hooks/pre-deploy.sh)
        if: ${{ hashFiles('.ci/hooks/pre-deploy.sh') != '' }}
        run: bash .ci/hooks/pre-deploy.sh
        env:
          CLOUDFLARE_PROJECT: ${{ env.PROJECT }}
          STATIC_DIST_DIR: ${{ env.DIST_DIR }}

      # 自动定位前端目录与锁文件（前端可能在子目录）
      - name: Detect frontend dir
        id: fe
        run: bash .ci/scripts/detect-frontend.sh >> "$GITHUB_OUTPUT"

      - name: Set up Node.js
        uses: actions/setup-node@v4
        with:
          node-version: 22
          cache: ${{ steps.fe.outputs.frontend_lock != '' && steps.fe.outputs.frontend_pm || '' }}
          cache-dependency-path: ${{ steps.fe.outputs.frontend_lock }}

      - name: Build (compile to HTML)
        working-directory: ${{ steps.fe.outputs.frontend_dir }}
        run: |
          if [ -z "${{ steps.fe.outputs.frontend_lock }}" ]; then npm install
          elif [ "${{ steps.fe.outputs.frontend_pm }}" = "pnpm" ]; then corepack enable; pnpm install --frozen-lockfile
          elif [ "${{ steps.fe.outputs.frontend_pm }}" = "yarn" ]; then yarn install --frozen-lockfile
          else npm ci; fi
          RUN_CMD="${{ env.BUILD_CMD }}"
          DETECTED="${{ steps.fe.outputs.frontend_build_cmd }}"
          if [ "$RUN_CMD" = "npm run build" ] && [ -n "$DETECTED" ]; then RUN_CMD="$DETECTED"; fi
          if [ "$RUN_CMD" = "npm run build" ] && [ "${{ steps.fe.outputs.frontend_has_build }}" != "true" ]; then
            echo "::error::前端目录没有 build 脚本，请设置 STATIC_BUILD_CMD"
            node -e "console.log(require('./package.json').scripts||{})" || true
            exit 1
          fi
          $RUN_CMD
          # SPA 回退：保证前端路由 404 兜底（vue 真实做法）
          cp "${{ env.DIST_DIR }}/index.html" "${{ env.DIST_DIR }}/404.html" 2>/dev/null || true

      # 统一产物到仓库根 dist/，供 Cloudflare 部署
      - name: Normalize dist to repo root
        run: |
          SRC="${{ steps.fe.outputs.frontend_dir }}/${{ env.DIST_DIR }}"
          if [ "$SRC" != "dist" ] && [ "$SRC" != "./dist" ]; then rm -rf dist; cp -r "$SRC" dist; fi

      - name: Deploy to Cloudflare Pages
        id: deploy
        uses: cloudflare/wrangler-action@v4
        with:
          apiToken: ${{ secrets.CLOUDFLARE_API_TOKEN }}
          accountId: ${{ secrets.CLOUDFLARE_ACCOUNT_ID }}
          command: pages deploy dist --project-name=${{ env.PROJECT }} --branch main

      - name: Custom post-deploy hook (.ci/hooks/post-deploy.sh)
        if: ${{ hashFiles('.ci/hooks/post-deploy.sh') != '' }}
        run: bash .ci/hooks/post-deploy.sh
        env:
          CLOUDFLARE_PROJECT: ${{ env.PROJECT }}
          DEPLOY_URL: ${{ steps.deploy.outputs.deployment-url }}
