# =============================================================================
# Dockerfile.nginx -- 极简应用镜像（nginx-prebuilt 策略）
#
# 直接使用 build-static 已产出的 dist/，不在镜像里重跑 npm build，
# 因此构建通常只需几秒（nginx:alpine + 复制静态文件）。
# 构建上下文：仓库根（dist/ 位于根目录）。
# =============================================================================
FROM nginx:alpine

COPY dist/ /usr/share/nginx/html/

# SPA 回退：前端路由 404 兜底
RUN printf 'server {\n  listen 80;\n  root /usr/share/nginx/html;\n  index index.html;\n  location / { try_files $uri $uri/ /index.html; }\n}\n' > /etc/nginx/conf.d/default.conf

EXPOSE 80
