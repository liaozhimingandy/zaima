# =============================================================================
# Dockerfile.assets  -- 静态资源独立镜像（公共约定）
#
# 作用: 把前端 build 产物(dist/) 装进一个「空镜像(scratch)」，
#       得到一个只包含静态文件的、体积极小的独立镜像，可
#       单独构建 / 推送 / 拉取 / 分发，供多个下游镜像或边缘节点共用。
#
# 用法(配合 docker-assets.yml):
#   - 该 Dockerfile 的构建上下文必须包含已构建好的 dist/ 目录
#     （由 CI 中 npm ci && npm run build 产出，或本地先 build）
#   - 产物镜像标签: <repo>:<ver>-assets / :latest-assets / :sha-xxxx-assets
#
# 下游消费(在 nginx / standalone 等 Dockerfile 中):
#   COPY --from=<repo>:<ver>-assets /usr/share/nginx/html /usr/share/nginx/html
# =============================================================================
FROM scratch

# 静态资源根目录（nginx 默认根 / 或任意下游约定目录）
COPY dist/ /usr/share/nginx/html/

# scratch 无 shell，无需 CMD/ENTRYPOINT；仅标注元数据便于检索
LABEL org.opencontainers.image.title="static-assets" \
      org.opencontainers.image.description="Static assets image (dist/ only)"
