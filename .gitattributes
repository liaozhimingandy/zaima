# 统一换行符，避免 Windows 检出后 shell 脚本/容器入口变成 CRLF 而无法执行
* text=auto

*.sh            text eol=lf
docker-entrypoint.sh text eol=lf
Dockerfile      text eol=lf
Dockerfile.app  text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
*.py            text eol=lf
*.ts            text eol=lf
*.vue           text eol=lf
*.json          text eol=lf
*.md            text eol=lf

# 二进制/锁文件不做转换
*.png binary
*.jpg binary
*.ico binary
*.woff binary
*.woff2 binary
package-lock.json -text
